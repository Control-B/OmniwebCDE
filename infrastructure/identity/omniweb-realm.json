{
  "realm": "omniweb",
  "enabled": true,
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "sslRequired": "external",
  "attributes": {
    "userProfileEnabled": "true"
  },
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"unmanagedAttributePolicy\":\"ADMIN_EDIT\",\"attributes\":[{\"name\":\"username\",\"displayName\":\"${username}\",\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\"]}},{\"name\":\"email\",\"displayName\":\"${email}\",\"validations\":{\"email\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]}},{\"name\":\"firstName\",\"displayName\":\"${firstName}\",\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]}},{\"name\":\"lastName\",\"displayName\":\"${lastName}\",\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]}}]}"
          ]
        }
      }
    ]
  },
  "roles": {
    "realm": [
      { "name": "owner" },
      { "name": "admin" },
      { "name": "member" },
      { "name": "viewer" }
    ]
  },
  "clients": [
    {
      "clientId": "omniweb-web",
      "name": "Omniweb Web",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:43210/*", "http://127.0.0.1:43210/*"],
      "webOrigins": ["http://localhost:43210", "http://127.0.0.1:43210"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:43210/*##http://127.0.0.1:43210/*"
      },
      "protocolMappers": [
        {
          "name": "omniweb-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "omniweb-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "organization id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "org_id",
            "claim.name": "org_id",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "avery",
      "email": "avery@omniweb.local",
      "emailVerified": true,
      "firstName": "Avery",
      "lastName": "Morgan",
      "enabled": true,
      "attributes": { "org_id": ["20000000-0000-4000-8000-000000000001"] },
      "realmRoles": ["owner"],
      "credentials": [{ "type": "password", "value": "change-me-on-first-login", "temporary": true }]
    }
  ]
}
